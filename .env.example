# Copie para `.env` na raiz. Os scripts de `catalogo/` leem este arquivo
# sozinhos (scripts/lib/env.mjs) — não é preciso exportar nada no shell.
#
# Precedência: uma variável já definida no ambiente SEMPRE ganha do `.env`.
# O `.env` é ignorado pelo git. Nunca commite valores reais.

# --- Bunny Stream ------------------------------------------------------------
# Painel: Stream > sua library > API. Use a Stream API Key DA LIBRARY,
# não a Account API Key.
BUNNY_LIBRARY_ID=123456
BUNNY_API_KEY=
# Hostname da pull zone, sem https:// — usado para montar a URL das capas
BUNNY_PULLZONE=vz-xxxxxxxx-xxx.b-cdn.net

# --- Cloudflare Pages --------------------------------------------------------
GTM_SITE=https://goias-tec-mais.pages.dev
# Mesma senha configurada na variável ADMIN_PASSWORD do projeto Pages.
# Os scripts também aceitam GTM_SENHA como alias.
ADMIN_PASSWORD=

# --- Legendas ----------------------------------------------------------------
# Só para scripts/legendas-assembly.mjs
ASSEMBLYAI_API_KEY=

# --- Arquivos de origem ------------------------------------------------------
# Onde estão os masters em disco (o HD `F:` do acervo)
MEDIA_LOCAL=F:\GOIAS_TEC_MAIS\01_CATALOGO

# --- Legado (legado-jellyfin/docker-compose.yml) ------------------------------
RCLONE_REMOTE=gdrive:
VFS_CACHE_MAX_SIZE=100G
