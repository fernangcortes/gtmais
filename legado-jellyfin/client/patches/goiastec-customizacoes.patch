 <script setup lang="ts">
-import { computed, ref } from 'vue';
+import { computed, onBeforeUnmount, onMounted, ref } from 'vue';
 import { playbackManager } from '#/store/playback-manager.ts';
 import { formatTime } from '#/utils/time.ts';
+import CommentTimeline from '#/components/Comments/CommentTimeline.vue';
 
+const currentItemId = computed(() => playbackManager.currentItem.value?.Id ?? '');
+const runtimeMs = computed(() => playbackManager.currentItemRuntime.value || 0);
 const currentInput = ref(0);
 const clicked = ref(false);
 const runtime = computed(() => playbackManager.currentItemRuntime.value / 1000);
@@ -42,4 +54,54 @@ function onRelease(): void {
   playbackManager.currentTime.value = currentInput.value;
   clicked.value = false;
 }
+
+/** Goiás Tec +: clicar em um marcador busca o vídeo na posição do comentário (ticks → ms). */
+function seekFromComment(ticks: number): void {
+  playbackManager.currentTime.value = ticks / 10000;
+}
+
+/* ------------------------------------------------------------------ */
+/* Alinhamento dos marcadores com a trilha do slider.
+   O VSlider tem rótulos de tempo no prepend/append (o VInput usa grid
+   "prepend | control | append"), então a trilha real (`.v-slider__container`,
+   que contém `.v-slider-track`) não ocupa a largura toda do wrapper.
+   Medimos a posição da trilha e encolhemos o overlay de marcadores até
+   ela — assim o `left: X%` dos marcadores bate com a posição do tempo no
+   slider (e com o thumb).                                        */
+/* ------------------------------------------------------------------ */
+const containerRef = ref<HTMLElement>();
+const trackInsets = ref({ left: '0px', right: '0px' });
+
+let resizeObserver: ResizeObserver | undefined;
+
+function measureTrackInsets(): void {
+  const container = containerRef.value;
+  const trackEl = container?.querySelector<HTMLElement>('.v-slider__container');
+  if (!container || !trackEl) return;
+
+  const containerRect = container.getBoundingClientRect();
+  const trackRect = trackEl.getBoundingClientRect();
+
+  trackInsets.value = {
+    left: `${Math.max(0, trackRect.left - containerRect.left)}px`,
+    right: `${Math.max(0, containerRect.right - trackRect.right)}px`
+  };
+}
+
+onMounted(() => {
+  measureTrackInsets();
+
+  // Re-mede quando a trilha refluir (ex.: largura dos rótulos de tempo muda)
+  resizeObserver = new ResizeObserver(measureTrackInsets);
+  if (containerRef.value) resizeObserver.observe(containerRef.value);
+  const trackEl = containerRef.value?.querySelector<HTMLElement>('.v-slider__container');
+  if (trackEl) resizeObserver.observe(trackEl);
+
+  // Re-mede depois que as fontes carregam (afetam a largura dos rótulos)
+  document.fonts?.ready
+    ?.then(() => measureTrackInsets())
+    .catch(() => undefined);
+});
+
+onBeforeUnmount(() => resizeObserver?.disconnect());
 </script>
